<Window x:Class="MemoHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MemoHub - Markdown メモアプリ" Height="800" Width="1000"
        Background="#F5F5F5"
        Icon="memo_icon.ico">
    <Window.Resources>
        <!-- モダンなボタンスタイル -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D1D1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- ヘッダーエリア -->
        <Border Background="White" Height="60" VerticalAlignment="Top" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝 MemoHub" FontSize="20" FontWeight="Bold" 
                               Foreground="#333" VerticalAlignment="Center"/>
                    <Border Width="1" Background="#E0E0E0" Margin="20,10" Height="30"/>
                    <TextBox x:Name="SearchBox" Width="400" Height="36"
                             FontSize="14" VerticalContentAlignment="Center"
                             Background="#F8F8F8" BorderBrush="#D0D0D0" BorderThickness="1"
                             Padding="10,0" KeyDown="SearchBox_KeyDown"/>
                    <Button Content="🔍 検索" Style="{StaticResource SecondaryButton}" 
                            Margin="10,0,0,0" Click="Search_Click" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- メインコンテンツ -->
        <Grid Margin="0,60,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 左側：メモ一覧 -->
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 新規作成ボタン -->
                    <Border DockPanel.Dock="Top" Background="#FAFAFA" 
                            BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16">
                        <Button Content="＋ 新規メモ" Style="{StaticResource PrimaryButton}" 
                                Click="New_Click" HorizontalAlignment="Stretch" Height="40"/>
                    </Border>
                    <!-- メモリスト -->
                    <ListBox x:Name="List" BorderThickness="0" Background="White"
                             SelectionChanged="List_SelectionChanged" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" 
                                        Background="White" Padding="16,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8F8F8"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- タイトル -->
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" 
                                                   FontSize="15" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                        <!-- 内容プレビュー -->
                                        <Border Grid.Row="1" 
                                                Background="#F5F5F5" 
                                                BorderBrush="#D0D0D0" 
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="0,6,0,0"
                                                Padding="8,6">
                                            <TextBlock Text="{Binding ContentPreview}" 
                                                       FontSize="13" 
                                                       Foreground="#666"
                                                       FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" 
                                                       MaxHeight="40" 
                                                       TextWrapping="Wrap"
                                                       ToolTip="メモ内容のプレビュー（コピーボタンで全文コピー可能）"/>
                                        </Border>
                                        <!-- アクションボタン -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                                    Margin="0,10,0,0" HorizontalAlignment="Left">
                                            <Button Content="📋 コピー" Style="{StaticResource SecondaryButton}"
                                                    Tag="{Binding}" Click="Copy_Click" Margin="0,0,8,0"/>
                                            <Button Content="✏️ 編集" Style="{StaticResource SecondaryButton}"
                                                    Tag="{Binding}" Click="Edit_Click" Margin="0,0,8,0"/>
                                            <Button Content="🗑️ 削除" Style="{StaticResource DeleteButton}"
                                                    Tag="{Binding}" Click="Delete_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <!-- 右側：詳細表示/編集エリア -->
            <Grid Grid.Column="1" Background="White">
                <!-- 空の状態表示 -->
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📝" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="メモを選択または新規作成してください" 
                               FontSize="18" Foreground="#999" HorizontalAlignment="Center"/>
                    <Button Content="＋ 新規メモを作成" Style="{StaticResource PrimaryButton}"
                            Click="New_Click" Margin="0,30,0,0" Padding="20,12" FontSize="16"/>
                </StackPanel>
                <!-- 閲覧モード -->
                <Grid x:Name="ViewPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- ヘッダー -->
                    <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="ViewTitle" FontSize="24" FontWeight="Bold" 
                                           Foreground="#333" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ViewDate" FontSize="13" Foreground="#999" Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="✏️ 編集" Style="{StaticResource SecondaryButton}"
                                        Click="EditCurrent_Click" Margin="0,0,8,0" Padding="16,8"/>
                                <Button Content="🗑️ 削除" Style="{StaticResource DeleteButton}"
                                        Click="DeleteCurrent_Click" Padding="16,8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- プレビューのみ -->
                    <wv2:WebView2 x:Name="ViewPreview" Grid.Row="1" Margin="20"/>
                </Grid>
                <!-- 編集モード -->
                <Grid x:Name="EditPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- ヘッダー -->
                    <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="📝 メモを編集" FontSize="18" FontWeight="SemiBold" 
                                           Foreground="#333"/>
                                <TextBlock Text="※ Markdown形式で保存されます" FontSize="12" 
                                           Foreground="#666" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="✕ キャンセル" Style="{StaticResource SecondaryButton}"
                                    Click="Cancel_Click" HorizontalAlignment="Right" Padding="16,8"/>
                        </Grid>
                    </Border>
                    <!-- 編集エリア -->
                    <Grid Grid.Row="1" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- タイトル入力 -->
                        <StackPanel>
                            <TextBlock Text="タイトル" FontSize="13" Foreground="#666" Margin="0,0,0,6"/>
                            <TextBox x:Name="TitleBox" FontSize="16" Padding="12,10"
                                     BorderBrush="#D0D0D0" Background="#FAFAFA"/>
                        </StackPanel>
                        <!-- コンテンツ編集とプレビュー -->
                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="内容 (Markdown)" 
                                           FontSize="13" Foreground="#666" Margin="0,0,0,6"/>
                                <TextBox x:Name="ContentBox" AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto" 
                                         HorizontalScrollBarVisibility="Disabled"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="14" Padding="12" BorderBrush="#D0D0D0"
                                         Background="#E8E8E8" TextChanged="ContentBox_TextChanged"/>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="プレビュー" 
                                           FontSize="13" Foreground="#666" Margin="0,0,0,6"/>
                                <Border BorderBrush="#D0D0D0" BorderThickness="1" Background="White">
                                    <wv2:WebView2 x:Name="EditPreview"/>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <!-- フッターボタン -->
                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" 
                            BorderThickness="0,1,0,0" Padding="20,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                                    Click="Cancel_Click" Margin="0,0,12,0" Padding="20,10"/>
                            <Button x:Name="SaveBtn" Content="💾 保存" Style="{StaticResource PrimaryButton}"
                                    Click="Save_Click" Padding="24,10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>